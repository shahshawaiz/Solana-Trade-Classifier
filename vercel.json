{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/reset-stats-build.cjs && vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=api/index.js",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    { "source": "/get-strategy-output", "destination": "/api/index" },
    { "source": "/api/(.*)", "destination": "/api/index" }
  ],
  "crons": [
    { "path": "/api/cron/tick", "schedule": "0 0 * * *" }
  ]
}
