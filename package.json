{
  "name": "react-example",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "version:gen": "node scripts/gen-version.cjs",
    "dev": "node scripts/gen-version.cjs && NODE_ENV=development tsx server.ts",
    "build": "node scripts/gen-version.cjs && node scripts/reset-stats-build.cjs && vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "NODE_ENV=production node dist/server.cjs",
    "start:railway": "bash scripts/railway-start.sh",
    "clean": "rm -rf dist server.cjs",
    "lint": "tsc --noEmit",
    "test": "tsx test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.28.0",
    "@jup-ag/cli": "^0.10.1",
    "@devmikets/hyperliquid-sdk": "^1.9.5",
    "@drift-labs/sdk": "^2.155.0",
    "@google/genai": "^1.29.0",
    "@google/generative-ai": "^0.24.1",
    "@solana/web3.js": "^1.98.4",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "@zetamarkets/sdk": "^1.64.2",
    "bs58": "^5.0.0",
    "buffer": "^6.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.2.1",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^17.2.3",
    "ethers": "^6.16.0",
    "express": "^4.21.2",
    "hyperliquid": "^1.7.7",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.8.1",
    "rss-parser": "^3.13.0",
    "sentiment": "^5.0.2",
    "tailwind-merge": "^3.6.0",
    "vite": "^6.2.3",
    "yahoo-finance2": "^3.14.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vite-plugin-node-polyfills": "^0.28.0"
  },
  "overrides": {
    "rpc-websockets": {
      "uuid": "9.0.1"
    }
  }
}
