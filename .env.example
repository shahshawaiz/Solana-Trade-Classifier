# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# CLAUDE_API_KEY: Anthropic API key, powers the trade-analysis and chat-agent features.
# Get one at console.anthropic.com.
CLAUDE_API_KEY="MY_CLAUDE_API_KEY"

# NEWS_API_KEY: Required for fetching market news from newsapi.org
# Sign up at newsapi.org to get a free key.
NEWS_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# TELEGRAM_BOT_TOKEN: Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=

# TELEGRAM_CHAT_ID: Telegram Channel or User Chat ID to send alerts to
TELEGRAM_CHAT_ID=

# PRIVATE_KEY: EVM Private key used for executing trades on Hyperliquid
PRIVATE_KEY=

# JUP_PRIVATE_KEY: Base58 Solana private key for the automated Jupiter trading wallet.
# When set, this is the single authoritative trading wallet — the server daemon signs
# and executes all automated trades with it. No in-browser Phantom connection is used.
JUP_PRIVATE_KEY=

# --- Strategy / ops tuning (all optional; defaults shown) ---
# STAGNANT_EXIT_MINUTES=600      # stagnation time-stop (was 360; see docs/STRATEGY.md §10)
# AUDIT_RETENTION_DAYS=30        # days of audit log kept + served by /api/audit-log
# AUDIT_LOG_FILE=/data/audit_log.jsonl   # point at a Railway volume so the 30 days survive redeploys
# JOURNAL_SEED_FILE=seed/trade-journal-seed.csv   # journal seed merged on every load
# JOURNAL_SEED=off               # disable the journal seed
